{
  "expo": {
    "name": "Service Finder Albania",
    "slug": "service-finder-albania",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "servicefinder",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servicefinder.albania"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4ECDB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.servicefinder.albania"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
